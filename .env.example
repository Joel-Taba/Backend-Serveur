# Copiez ce fichier en .env et remplissez les valeurs pour votre environnement.
# .env n'est jamais commité (voir .gitignore) : c'est la seule source de secrets.

# --- Django ------------------------------------------------------------------
# DJANGO_SETTINGS_MODULE ne se règle PAS ici : ce fichier .env n'est lu
# qu'une fois le module de réglages déjà choisi. Utilisez plutôt :
#   export DJANGO_SETTINGS_MODULE=config.settings.prod
# (par défaut, manage.py utilise config.settings.dev — voir README.md)
DJANGO_SECRET_KEY=change-moi-avec-une-vraie-cle-aleatoire
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de données -----------------------------------------------------
# Par défaut : SQLite local (db.sqlite3), aucune valeur requise.
# Pour PostgreSQL : postgres://user:motdepasse@host:5432/nom_de_base
# DATABASE_URL=

# --- CORS (origines autorisées à appeler cette API) -----------------------
# Laisser vide tant que le frontend n'est pas branché.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Email (réinitialisation de mot de passe, notifications de contact) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@flores-gong-nota.local
CONTACT_NOTIFICATION_EMAIL=joeltaba4@gmail.com

# --- Frontend (utilisé pour construire les liens dans les emails) ---------
FRONTEND_BASE_URL=http://localhost:3000

# --- Connexion Google (bouton "Continuer avec Google") --------------------
# Laisser vide désactive proprement l'endpoint (réponse 501).
GOOGLE_OAUTH_CLIENT_ID=

# --- Upload de documents ---------------------------------------------------
MAX_UPLOAD_SIZE_MB=300
